#!/usr/bin/env bash
# Code Ocean entry point. The GitHub Actions workflow copies this file to /code/run.
#
# Expected layout of the capsule's /data folder (mirrors the repo's local layout):
#   /data/weights/DINOMHC_WEIGHTS/{fold_0,fold_1,fold_2,model_config.yaml}
#   /data/datasets/MS/TEST.csv
# Outputs are written to /results.
set -euo pipefail

cd "$(dirname "$0")"
DATA=../data
WEIGHTS="$DATA/weights/DINOMHC_WEIGHTS"

python -u test.py \
    --checkpoints "$WEIGHTS/fold_0/" "$WEIGHTS/fold_1/" "$WEIGHTS/fold_2/" \
    --benchmark_dataset "$DATA/datasets/MS/TEST.csv" \
    --output ../results/TEST \
    --model_config "$WEIGHTS/model_config.yaml" \
    --device cuda \
    --calculate_by_allele
